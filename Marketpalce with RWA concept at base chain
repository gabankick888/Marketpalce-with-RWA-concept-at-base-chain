pragma solidity ^0.8.24;

import "@openzeppelin/contracts/token/ERC721/extensions/ERC721URIStorage.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

contract RWAMarketplace is ERC721URIStorage, Ownable, ReentrancyGuard {

    uint256 public nextTokenId = 1;
    uint256 public feePercent = 200; // 2%

    struct Asset {
        uint256 tokenId;
        address seller;
        uint256 price;
        bool listed;
    }

    mapping(uint256 => Asset) public assets;

    event AssetMinted(
        uint256 indexed tokenId,
        address indexed owner,
        string metadataURI
    );

    event AssetListed(
        uint256 indexed tokenId,
        uint256 price
    );

    event AssetSold(
        uint256 indexed tokenId,
        address buyer,
        uint256 price
    );

    constructor()
        ERC721("Real World Assets", "RWA")
        Ownable(msg.sender)
    {}

    // Only authorized issuer can mint RWA NFTs
    function mintAsset(
        address recipient,
        string memory metadataURI
    ) external onlyOwner returns (uint256) {

        uint256 tokenId = nextTokenId++;

        _safeMint(recipient, tokenId);
        _setTokenURI(tokenId, metadataURI);

        emit AssetMinted(tokenId, recipient, metadataURI);

        return tokenId;
    }

    // Seller lists an asset
    function listAsset(
        uint256 tokenId,
        uint256 price
    ) external {

        require(ownerOf(tokenId) == msg.sender, "Not owner");
        require(price > 0, "Invalid price");
        require(!assets[tokenId].listed, "Already listed");

        _transfer(msg.sender, address(this), tokenId);

        assets[tokenId] = Asset({
            tokenId: tokenId,
            seller: msg.sender,
            price: price,
            listed: true
        });

        emit AssetListed(tokenId, price);
    }

    // Buyer purchases an RWA NFT
    function buyAsset(
        uint256 tokenId
    ) external payable nonReentrant {

        Asset memory asset = assets[tokenId];

        require(asset.listed, "Not listed");
        require(msg.value == asset.price, "Incorrect payment");

        delete assets[tokenId];

        uint256 fee = (msg.value * feePercent) / 10000;
        uint256 sellerAmount = msg.value - fee;

        // Transfer payment
        (bool sellerPaid, ) = payable(asset.seller).call{
            value: sellerAmount
        }("");

        require(sellerPaid, "Seller payment failed");

        (bool feePaid, ) = payable(owner()).call{
            value: fee
        }("");

        require(feePaid, "Fee payment failed");

        // Transfer NFT to buyer
        _safeTransfer(
            address(this),
            msg.sender,
            tokenId,
            ""
        );

        emit AssetSold(tokenId, msg.sender, msg.value);
    }

    // Seller cancels listing
    function cancelListing(
        uint256 tokenId
    ) external {

        Asset memory asset = assets[tokenId];

        require(asset.listed, "Not listed");
        require(asset.seller == msg.sender, "Not seller");

        delete assets[tokenId];

        _safeTransfer(
            address(this),
            msg.sender,
            tokenId,
            ""
        );
    }

    // Update marketplace fee (maximum 5%)
    function setFee(uint256 newFee)
        external onlyOwner
    {
        require(newFee <= 500, "Fee too high");
        feePercent = newFee;
    }
}
